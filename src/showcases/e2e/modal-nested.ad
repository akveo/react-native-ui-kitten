context platform=ios
context timeout=180000
open "com.uikitten.showcases" --relaunch --platform ios
wait "id=\"toggle-theme\"" 60000
react-native "dismiss-overlay"
wait "id=\"section-Button-title\"" 10000
scroll "bottom"
wait "id=\"section-Autocomplete-title\"" 10000
scroll "up" 0.5
scroll "up" 0.5
scroll "up" 0.5
scroll "up" 0.5
scroll "up" 0.5
scroll "up" 0.5
scroll "up" 0.5
scroll "up" 0.5
scroll "up" 0.5
scroll "up" 0.5
scroll "up" 0.5
scroll "up" 0.5
scroll "up" 0.5
scroll "up" 0.5
scroll "up" 0.5
scroll "up" 0.5
wait "label=\"TOGGLE MODAL\"" 10000
press "role=\"button\" label=\"TOGGLE MODAL\" || label=\"TOGGLE MODAL\""
wait "text" "Pick an option" 5000
press "id=\"modal-select\" || role=\"other\" label=\"Pick an option\" || label=\"Pick an option\""
wait "text" "Option 2" 5000
press "role=\"other\" label=\"Option 2\" || label=\"Option 2\""
wait "absent" "label=\"Pick an option\"" 5000
wait "label=\"Option 2\"" 5000
close
