context platform=android
context timeout=180000
open "com.uikitten.showcases" --relaunch --platform android
wait "id=\"toggle-theme\"" 60000
react-native "dismiss-overlay"
wait "id=\"section-Button-title\"" 10000
scroll "down"
scroll "down"
scroll "down"
scroll "down"
scroll "down"
scroll "down"
scroll "down"
scroll "down"
scroll "down"
scroll "down"
scroll "down"
scroll "down"
scroll "down"
wait "id=\"section-Popover-title\"" 10000
press "role=\"button\" label=\"TOGGLE POPOVER\" || label=\"TOGGLE POPOVER\""
wait "label=\"Welcome to UI Kitten 😻\"" 5000
back
wait "absent" "label=\"Welcome to UI Kitten 😻\"" 5000
close
