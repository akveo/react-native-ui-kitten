context platform=ios
context timeout=180000
open "com.uikitten.showcases" --relaunch --platform ios
wait "id=\"toggle-theme\"" 60000
react-native "dismiss-overlay"
scroll "down" 1
scroll "down" 1
scroll "down" 1
scroll "down" 1
wait "id=\"section-InputAccessories-title\"" 10000
press "id=\"input-accessories-toggle\""
wait "id=\"section-InputAccessories-title\"" 5000
press "value=\"Place your Text\""
type "kitten"
wait "role=\"textfield\" value=\"kitten\"" 5000
press "id=\"input-accessories-toggle\""
wait "id=\"section-InputAccessories-title\"" 5000
close
