{
  "name": "@ui-kitten/components",
  "description": "React Native UI components based on Eva Design System",
  "version": "6.0.0-beta.2",
  "main": "./lib/commonjs/index.js",
  "module": "./lib/module/index.js",
  "types": "./lib/typescript/commonjs/index.d.ts",
  "react-native": "./index.ts",
  "source": "./index.ts",
  "exports": {
    ".": {
      "source": "./index.ts",
      "react-native": {
        "types": "./lib/typescript/module/index.d.ts",
        "default": "./index.ts"
      },
      "import": {
        "types": "./lib/typescript/module/index.d.ts",
        "default": "./lib/module/index.js"
      },
      "require": {
        "types": "./lib/typescript/commonjs/index.d.ts",
        "default": "./lib/commonjs/index.js"
      }
    },
    "./devsupport": {
      "source": "./devsupport/index.ts",
      "react-native": {
        "types": "./lib/typescript/module/devsupport/index.d.ts",
        "default": "./devsupport/index.ts"
      },
      "import": {
        "types": "./lib/typescript/module/devsupport/index.d.ts",
        "default": "./lib/module/devsupport/index.js"
      },
      "require": {
        "types": "./lib/typescript/commonjs/devsupport/index.d.ts",
        "default": "./lib/commonjs/devsupport/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "devsupport",
    "theme",
    "ui",
    "*.ts",
    "lib",
    "!**/__tests__",
    "!**/*.spec.*"
  ],
  "author": "UI Kitten Contributors",
  "license": "MIT",
  "homepage": "https://github.com/akveo/react-native-ui-kitten#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/akveo/react-native-ui-kitten.git"
  },
  "bugs": {
    "url": "https://github.com/akveo/react-native-ui-kitten/issues"
  },
  "keywords": [
    "react-native",
    "ui-kitten",
    "ui-kit",
    "eva-design"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "bob build && node ../../scripts/esm-declaration-extensions.js",
    "typecheck": "tsc -p tsconfig.build.json --noEmit",
    "clean": "rm -rf lib"
  },
  "dependencies": {
    "@ui-kitten/mapping-base": "^6.0.0-beta.1",
    "@ui-kitten/processor": "^6.0.0-beta.1",
    "fecha": "3.0.3",
    "hoist-non-react-statics": "^3.2.1"
  },
  "peerDependencies": {
    "react": ">=18.2.0",
    "react-native": ">=0.72.0",
    "react-native-svg": ">=13.0.0"
  },
  "devDependencies": {
    "typescript": "^5.3.0"
  },
  "react-native-builder-bob": {
    "source": ".",
    "output": "lib",
    "exclude": "{**/{__tests__,__fixtures__,__mocks__,node_modules,tests}/**,**/*.spec.*,package.json,CHANGELOG.md,tsconfig*.json,lib/**}",
    "targets": [
      [
        "commonjs",
        {
          "esm": true
        }
      ],
      [
        "module",
        {
          "esm": true
        }
      ],
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ]
  }
}
